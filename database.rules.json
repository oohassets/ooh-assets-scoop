{
    "rules": {
        ".read": "auth != null && !root.child('userClient').child(auth.token.email.replace('.', '_').replace('.', '_').replace('.', '_').replace('.', '_')).exists() && !root.child('userSupplier').child(auth.token.email.replace('.', '_').replace('.', '_').replace('.', '_').replace('.', '_')).exists()",
            ".write": false,

                "user": {
                      ".write": false
                          },

                              "userClient": {
                                    ".write": false
                                        },

                                            "userSupplier": {
                                                  ".write": false
                                                      },

                                                          "fcmTokens": {
                                                                "$uid": {
                                                                        ".write": "auth != null && auth.uid === $uid"
                                                                              }
                                                                                  },

                                                                                      "Campaigns_Booking": {
                                                                                            ".write": "auth != null && (root.child('user').child(auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).child('rule').val() == 'admin' || root.child('user').child(auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).child('rule').val() == 'sales')"
                                                                                                },

                                                                                                    "Campaign_Logs": {
                                                                                                          ".write": "auth != null && root.child('user').child(auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).child('rule').val() == 'admin'"
                                                                                                              },

                                                                                                                  "assetrate": {
                                                                                                                        ".write": "auth != null && root.child('user').child(auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).child('rule').val() == 'admin'"
                                                                                                                            },

                                                                                                                                "assetmap": {
                                                                                                                                      ".write": "auth != null && root.child('user').child(auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).child('rule').val() == 'admin'"
                                                                                                                                          },

                                                                                                                                              "oohassets": {
                                                                                                                                                    ".write": "auth != null && root.child('user').child(auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).child('rule').val() == 'admin'"
                                                                                                                                                        },

                                                                                                                                                            "vehiclecounts": {
                                                                                                                                                                  ".write": "auth != null && root.child('user').child(auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).child('rule').val() == 'admin'"
                                                                                                                                                                      },

                                                                                                                                                                          "$other": {
                                                                                                                                                                                ".write": "auth != null && root.child('user').child(auth.token.email.replace('.', ',').replace('.', ',').replace('.', ',').replace('.', ',')).child('rule').val() == 'admin'"
                                                                                                                                                                                    }
                                                                                                                                                                                      }
                                                                                                                                                                                      }
